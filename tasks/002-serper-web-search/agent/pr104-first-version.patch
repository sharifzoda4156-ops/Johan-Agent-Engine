+app.patch("/api/chats/:chatId", async (req, res) => {
+  const body = req.body || {};
+  if (!Object.prototype.hasOwnProperty.call(body, "webSearchEnabled")) {
+    return res.status(400).json({ error: "webSearchEnabled обязателен (1 | 0 | null)" });
+  }
+  const raw = body.webSearchEnabled;
+  // null = наследовать глобальный флаг; 1/0 = явное переопределение. Принимаем и
+  // строковые/булевы эквиваленты от клиента, всё прочее — невалидный ввод.
+  let flag;
+  if (raw === null) flag = null;
+  else if (raw === 1 || raw === true || raw === "1") flag = 1;
+  else if (raw === 0 || raw === false || raw === "0") flag = 0;
+  else {
+    return res.status(400).json({ error: "webSearchEnabled должен быть 1, 0 или null" });
+  }
