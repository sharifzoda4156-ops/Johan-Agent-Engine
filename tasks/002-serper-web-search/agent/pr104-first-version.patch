+    assert.strictEqual(row.model, "serper");
+    assert.strictEqual(row.tokensIn, 0);
+    assert.strictEqual(row.tokensOut, 0);
+    assert.strictEqual(row.cost, 1);
+    assert.strictEqual(
+      (row.tokensIn || 0) + (row.tokensOut || 0),
