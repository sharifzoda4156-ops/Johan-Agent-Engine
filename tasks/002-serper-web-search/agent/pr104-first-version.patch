+
+    const cap = captureErrors();
+    let results;
+    try {
+      results = await web.searchWeb("q");
+    } finally {
+      cap.restore();
+    }
+
+    assert.deepStrictEqual(results, []);
+    assert.ok(cap.calls.length >= 1, "ожидался лог console.error при не-200");
+  });
+
