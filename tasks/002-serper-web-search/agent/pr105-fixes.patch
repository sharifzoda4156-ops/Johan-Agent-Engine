+ * limit — TenmaLimitError или результат getLimitStatus. Не бросает.
+ */
+async function stopTaskForLimit(store, { userId, chatId, taskId, limit, progressEvents = [] }) {
+  const content = TenmaLimitError.messageFor(limit.scope);
