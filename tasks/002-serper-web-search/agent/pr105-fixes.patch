+      chatId,
+      role: "agent",
+      content,
+      meta: { kind: "limit_reached", task_id: taskId, scope: limit.scope, resetAt: limit.resetAt },
+    });
+    return true;
+  } catch (e) {
+    console.log(`[limit] ${taskId}: limit stop failed:`, e.message);
+    return false;
   }
 }
 
 module.exports = {
