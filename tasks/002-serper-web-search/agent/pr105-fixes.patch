diff --git a/scripts/usage-limit-soft-selftest.js b/scripts/usage-limit-soft-selftest.js
new file mode 100644
index 0000000..e2b0fe4
--- /dev/null
+++ b/scripts/usage-limit-soft-selftest.js
@@ -0,0 +1,139 @@
+/**
+ * Self-test: мягкий лимит тарифа вместо сырой ошибки.
+ *  - TenmaLimitError несёт code=usage_limit, scope и resetAt (начало следующих
+ *    UTC-суток / UTC-месяца);
+ *  - getLimitStatus отдаёт клиенту { limited, code, scope, resetAt } без записи
+ *    в журнал ошибок и без чисел расхода;
+ *  - limitPayload: 429-тело сохраняет прежний error-текст и добавляет код;
+ *  - задача, упёршаяся в лимит при клейме, пишет в чат kind=limit_reached
+ *    (не kind=error) и не шлёт отчёт о сбое.
+ * Без БД/сети — mock db. Запуск: node scripts/usage-limit-soft-selftest.js
+ */
+process.env.JAE_URL = "http://jae.test";
+const assert = require("assert");
+
+const Module = require("module");
+const _origLoad = Module._load;
+const EXTERNAL_STUBS = new Set([
+  "pg", "better-sqlite3", "@node-rs/argon2", "ssh2",
+  "jsonwebtoken", "google-auth-library", "ws", "express",
+]);
+function universalStub() {
+  const target = function () { return proxy; };
+  const proxy = new Proxy(target, {
+    get(_, prop) { return prop === "then" ? undefined : universalStub(); },
+    apply() { return universalStub(); },
+    construct() { return universalStub(); },
+  });
+  return proxy;
+}
+Module._load = function (request, parent, isMain) {
+  if (EXTERNAL_STUBS.has(request)) return universalStub();
+  return _origLoad.call(this, request, parent, isMain);
+};
+
+let passed = 0;
+async function check(name, fn) {
+  await fn();
+  passed++;
+  console.log(`  ok  ${name}`);
+}
+
+const logs = [];
+let usedDay = 0;
+let usedMonth = 0;
+const fakeDb = {
+  async getTier() { return "free"; },
+  async getTokenUsageSince(_userId, since) {
+    const d = new Date();
+    return since >= Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()) ? usedDay : usedMonth;
+  },
+  async logAgentError(entry) { logs.push(entry); },
+};
+require("../db");
+require.cache[require.resolve("../db")].exports = fakeDb;
+const usageLimits = require("../lib/usageLimits");
+
+async function main() {
+  await check("resetAt: следующие UTC-сутки и следующий UTC-месяц", async () => {
+    const now = Date.UTC(2026, 9, 11, 20, 15, 0);
+    assert.strictEqual(usageLimits.resetAtFor("daily", now), Date.UTC(2026, 9, 12));
+    assert.strictEqual(usageLimits.resetAtFor("monthly", now), Date.UTC(2026, 10, 1));
+    assert.strictEqual(usageLimits.resetAtFor("daily", Date.UTC(2026, 11, 31, 23, 59)), Date.UTC(2027, 0, 1));
+    assert.strictEqual(usageLimits.resetAtFor("monthly", Date.UTC(2026, 11, 5)), Date.UTC(2027, 0, 1));
+  });
+
+  await check("ниже лимита: getLimitStatus = { limited: false }", async () => {
+    usedDay = 10; usedMonth = 10;
+    assert.deepStrictEqual(await usageLimits.getLimitStatus("u"), { limited: false });
+  });
+
+  await check("дневной лимит: checkLimit бросает код, scope и resetAt", async () => {
+    usedDay = usageLimits.TIER_LIMITS.free.daily; usedMonth = usedDay;
+    logs.length = 0;
+    const before = Date.now();
+    const e = await usageLimits.checkLimit("u").then(() => null, (err) => err);
+    assert.ok(e instanceof usageLimits.TenmaLimitError);
+    assert.strictEqual(e.code, "usage_limit");
+    assert.strictEqual(e.scope, "daily");
+    assert.strictEqual(e.resetAt, usageLimits.resetAtFor("daily", before));
+    assert.ok(e.resetAt > before);
+    assert.strictEqual(logs.length, 1);
+    const body = usageLimits.limitPayload(e);
+    assert.deepStrictEqual(body, { error: e.tenmaMessage, code: "usage_limit", scope: "daily", resetAt: e.resetAt });
+  });
+
+  await check("getLimitStatus: без журнала ошибок и без чисел расхода", async () => {
+    logs.length = 0;
+    const s = await usageLimits.getLimitStatus("u");
+    assert.deepStrictEqual(Object.keys(s).sort(), ["code", "limited", "resetAt", "scope"]);
+    assert.strictEqual(s.limited, true);
+    assert.strictEqual(s.scope, "daily");
+    assert.strictEqual(logs.length, 0);
+  });
+
+  await check("задача у лимита при клейме: kind=limit_reached, без отчёта о сбое", async () => {
+    const queue = require("../lib/agentTaskQueue");
+    const advanced = [];
+    const messages = [];
+    const db = {
+      async advanceAgentTask(taskId, status, extra) { advanced.push({ taskId, status, extra }); return { taskId }; },
+      async appendChatMessageAgent(m) { messages.push(m); },
+      async logAgentError() {},
+    };
+    let fetched = 0;
+    const origFetch = globalThis.fetch;
+    globalThis.fetch = async () => { fetched++; return { ok: true, status: 200, async json() { return {}; } }; };
+    try {
+      await queue.processClaimedTask(db, { taskId: "t1", userId: "u", chatId: "c1", prompt: "x" });
+    } finally {
+      globalThis.fetch = origFetch;
+    }
+    assert.strictEqual(fetched, 0, "JAE и Telegram не вызываются");
+    assert.strictEqual(advanced.length, 1);
+    assert.strictEqual(advanced[0].status, "failed");
+    assert.strictEqual(advanced[0].extra.error, usageLimits.TenmaLimitError.messageFor("daily"));
+    assert.strictEqual(messages.length, 1);
+    assert.strictEqual(messages[0].meta.kind, "limit_reached");
+    assert.strictEqual(messages[0].meta.scope, "daily");
+    assert.strictEqual(messages[0].meta.task_id, "t1");
+    assert.ok(messages[0].meta.resetAt > Date.now());
+  });
+
+  await check("stopTaskForLimit: задачу уже отменили — сообщение не пишется", async () => {
+    const messages = [];
+    const ok = await usageLimits.stopTaskForLimit(
+      { async advanceAgentTask() { return null; }, async appendChatMessageAgent(m) { messages.push(m); } },
+      { userId: "u", chatId: "c", taskId: "t2", limit: { scope: "monthly", resetAt: 1 } },
+    );
+    assert.strictEqual(ok, false);
+    assert.strictEqual(messages.length, 0);
+  });
+
+  console.log(`\n${passed} passed`);
+}
+
+main().catch((e) => {
+  console.error("FAIL:", e);
+  process.exit(1);
+});
