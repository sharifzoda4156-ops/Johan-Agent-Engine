+ * ввод до resetAt. Числа расхода наружу не отдаём — только окно и время сброса.
+ */
+async function getLimitStatus(userId) {
+  const hit = await findExceeded(userId);
+  if (!hit) return { limited: false };
+  return { limited: true, code: LIMIT_CODE, scope: hit.scope, resetAt: hit.resetAt };
+}
+
+/**
