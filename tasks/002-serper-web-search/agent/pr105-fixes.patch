+
+/** Кидает TenmaLimitError, если userId уже выбрал дневной или месячный лимит своего tier. */
+async function checkLimit(userId, { requestId } = {}) {
+  const hit = await findExceeded(userId);
+  if (!hit) return;
+  const detail = formatLimitLog(hit);
+  await db.logAgentError({ userId, requestId: requestId || null, stage: "limit", source: "tenma", error: detail });
+  throw new TenmaLimitError(hit.scope, hit);
+}
+
+/**
