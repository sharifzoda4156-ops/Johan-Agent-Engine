diff --git a/lib/webSearch.js b/lib/webSearch.js
new file mode 100644
index 0000000..d16af53
--- /dev/null
+++ b/lib/webSearch.js
@@ -0,0 +1,184 @@
+// ─────────────────────────────────────────────────────────────────────────────
+// webSearch — веб-поиск для плейн-чата через Serper (google-обёртка). Слой 3.
+//
+// Две части:
+//   1) searchWeb(query, {num})     — ЧИСТЫЙ вызов Serper (сигнатура из ТЗ).
+//   2) runChatWebSearch({...})      — оркестратор для чата: rate-limit ДО вызова
+//      Serper + учёт расхода (usage), поверх searchWeb.
+//
+// Механизмы НЕ изобретаем, а переиспользуем: usage — та же таблица/метод
+// db.recordUsage, что и для вызовов модели (kind="web_search" — отдельная статья
+// расхода); флаг включения — process.env (значение может приходить из server_config
+// через serverConfig.loadConfigIntoEnv, как и прочие фичефлаги). Нативный fetch,
+// без сторонних http-клиентов.
+// ─────────────────────────────────────────────────────────────────────────────
+
+const db = require("../db");
+
+const SERPER_URL = "https://google.serper.dev/search";
+const SEARCH_TIMEOUT_MS = 5000;
+const USAGE_KIND = "web_search";
+const USAGE_MODEL = "serper";
+
+/** Лимит частоты поиска per user (запросов в минуту). Дефолт разумный, env-override. */
+function ratePerMinute() {
+  const n = Number(process.env.WEB_SEARCH_RATE_PER_MIN);
+  return Number.isFinite(n) && n > 0 ? n : 10;
+}
+
+/** Нет ключа — понятная (отдельная) ошибка, чтобы вызывающий отличил её от
+ * пустого результата таймаута/не-200. */
+class MissingSerperKeyError extends Error {
+  constructor() {
+    super("SERPER_API_KEY не задан — веб-поиск невозможен");
+    this.name = "MissingSerperKeyError";
+  }
+}
+
+/**
+ * Чистый вызов Serper (сигнатура строго из ТЗ: searchWeb(query, { num = 5 })).
+ *  - нет ключа            → бросает MissingSerperKeyError (понятная ошибка);
+ *  - таймаут 5с / сеть     → [] + лог (чат из-за поиска не роняем);
+ *  - не-200 / не JSON      → [] + лог;
+ *  - успех                → нормализованный [{title, link, snippet, position}].
+ */
+async function searchWeb(query, { num = 5 } = {}) {
+  const key = process.env.SERPER_API_KEY;
+  if (!key) throw new MissingSerperKeyError();
+
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), SEARCH_TIMEOUT_MS);
+  let res;
+  try {
+    res = await fetch(SERPER_URL, {
+      method: "POST",
+      headers: { "X-API-KEY": key, "Content-Type": "application/json" },
+      body: JSON.stringify({ q: query, num }),
+      signal: controller.signal,
+    });
+  } catch (e) {
+    // AbortError = таймаут 5с; прочее = сетевой сбой. И то и другое — пустой
+    // результат + лог, чтобы поиск не сорвал ответ модели.
+    console.log(`[webSearch] запрос не удался: ${e.name === "AbortError" ? "таймаут 5с" : e.message}`);
+    return [];
+  } finally {
+    clearTimeout(timer);
+  }
+
+  if (!res.ok) {
+    console.log(`[webSearch] Serper вернул ${res.status}`);
+    return [];
+  }
+
+  let data;
+  try {
+    data = await res.json();
+  } catch (e) {
+    console.log(`[webSearch] ответ Serper не JSON: ${e.message}`);
+    return [];
+  }
+
+  const organic = Array.isArray(data.organic) ? data.organic : [];
+  const results = organic.map((item, i) => ({
+    title: item.title ?? "",
+    link: item.link ?? "",
+    snippet: item.snippet ?? "",
+    position: typeof item.position === "number" ? item.position : i + 1,
+  }));
+
+  // POST-PROCESSING HOOK — результаты Serper готовы и нормализованы, но ещё НЕ
+  // отданы дальше. Сюда позже встанут фильтры / реранк / дедуп / кэш. Сейчас
+  // намеренно ничего не делаем — только зафиксированное место для расширения.
+
+  return results;
+}
+
+/**
+ * Эффективный тумблер веб-поиска для чата. Глобально — env WEB_SEARCH_ENABLED
+ * (значение может приходить из server_config через loadConfigIntoEnv — тот же
+ * механизм фичефлагов). Переопределение на чат — колонка chats."webSearchEnabled"
+ * (NULL = наследует глобальный; 1 = вкл; 0 = выкл). Нового механизма не заводим.
+ */
+function webSearchEnabledFor(chat) {
+  const globalOn = process.env.WEB_SEARCH_ENABLED === "1";
+  if (chat && chat.webSearchEnabled != null) return Number(chat.webSearchEnabled) === 1;
+  return globalOn;
+}
+
+/**
+ * Оркестратор поиска для плейн-чата: rate-limit (per user, окно 60с, ДО вызова
+ * Serper) → searchWeb → учёт расхода. Никогда не бросает — чат из-за поиска не
+ * падает. Возвращает { status, results, limit? }:
+ *   ok           — поиск выполнен (results заполнены/пусты);
+ *   rate_limited — превышен лимит частоты, Serper НЕ вызывался (limit = порог);
+ *   no_key       — SERPER_API_KEY не задан;
+ *   error        — иной сбой (залогирован).
+ * Расход пишем ТОЛЬКО когда Serper реально дёргали (kind="web_search",
+ * отдельная статья; токены 0/0 — поиск не съедает модельный токен-лимит, cost=1).
+ */
+async function runChatWebSearch({ userId, query, num = 5 }) {
+  // Rate limit ДО вызова Serper: считаем web_search-обращения за последние 60с.
+  const limit = ratePerMinute();
+  const since = Date.now() - 60_000;
+  const used = await db.countUsageSince(userId, USAGE_KIND, since);
+  if (used >= limit) {
+    return { status: "rate_limited", results: [], limit };
+  }
+
+  let results;
+  try {
+    results = await searchWeb(query, { num });
+  } catch (e) {
+    if (e instanceof MissingSerperKeyError) {
+      console.log(`[webSearch] ${e.message}`);
+      return { status: "no_key", results: [] };
+    }
+    console.log(`[webSearch] неожиданный сбой: ${e.message}`);
+    return { status: "error", results: [] };
+  }
+
+  // Каждый фактический вызов Serper — отдельная статья расхода. Токены 0/0,
+  // чтобы поиск НЕ шёл в модельный токен-лимит (usageLimits считает tokensIn+Out);
+  // cost=1 — «единица поиска» для учёта/тарификации.
+  await db.recordUsage({
+    userId,
+    kind: USAGE_KIND,
+    model: USAGE_MODEL,
+    tokensIn: 0,
+    tokensOut: 0,
+    cost: 1,
+  });
+
+  return { status: "ok", results };
+}
+
+/**
+ * Флаг webSearch для JAE (/chat/stream) при включённом слое 3. Глобус композера
+ * (askOpts.webSearch) включает встроенный поиск OpenRouter (":online" в
+ * apps/jae/model_choice.py). Если Serper уже дал результаты для этого ответа —
+ * ":online" не включаем: двойной поиск = двойная оплата и дубли в контексте.
+ * Во всех остальных случаях (Serper выключен, нет ключа, лимит, сбой, пусто) —
+ * глобус работает как раньше.
+ */
+function jaeWebSearchFlag(composerWebSearch, searchOutcome) {
+  const serperDelivered = !!searchOutcome && searchOutcome.status === "ok" && searchOutcome.results.length > 0;
+  return composerWebSearch === true && !serperDelivered;
+}
+
+/** Справочный блок для контекста модели: title + snippet + link по каждому. */
+function formatResultsForContext(results, max = 5) {
+  return results
+    .slice(0, max)
+    .map((r, i) => `${i + 1}. ${r.title}\n${r.snippet}\n${r.link}`)
+    .join("\n\n");
+}
+
+module.exports = {
+  searchWeb,
+  runChatWebSearch,
+  webSearchEnabledFor,
+  formatResultsForContext,
+  jaeWebSearchFlag,
+  MissingSerperKeyError,
+  USAGE_KIND,
+};
diff --git a/scripts/web-search-selftest.js b/scripts/web-search-selftest.js
new file mode 100644
index 0000000..4296d4e
--- /dev/null
+++ b/scripts/web-search-selftest.js
@@ -0,0 +1,171 @@
+/**
+ * Self-test lib/webSearch.js — без сети и без БД (fetch и db замоканы).
+ * Запуск: node scripts/web-search-selftest.js
+ */
+const assert = require("assert");
+const path = require("path");
+
+// Заглушка db ДО require webSearch (он делает require("../db")).
+const dbPath = require.resolve("../db");
+const usageCalls = [];
+let usageCount = 0;
+require.cache[dbPath] = {
+  id: dbPath,
+  loaded: true,
+  exports: {
+    async countUsageSince() {
+      return usageCount;
+    },
+    async recordUsage(rec) {
+      usageCalls.push(rec);
+      return "id";
+    },
+  },
+};
+
+const webSearch = require("../lib/webSearch");
+
+let passed = 0;
+async function check(name, fn) {
+  await fn();
+  passed++;
+  console.log(`  ok  ${name}`);
+}
+
+function mockFetch(impl) {
+  global.fetch = impl;
+}
+function serperResponse(organic, { ok = true, status = 200 } = {}) {
+  return async () => ({
+    ok,
+    status,
+    async json() {
+      return { organic };
+    },
+    async text() {
+      return "";
+    },
+  });
+}
+
+async function main() {
+  // ── searchWeb: нормализация ────────────────────────────────────────────────
+  await check("searchWeb: нормализует organic -> {title,link,snippet,position}", async () => {
+    process.env.SERPER_API_KEY = "k";
+    mockFetch(
+      serperResponse([
+        { title: "A", link: "http://a", snippet: "sa", position: 1 },
+        { title: "B", link: "http://b", snippet: "sb" }, // без position -> idx+1
+      ])(),
+    );
+    // serperResponse возвращает промис объекта — обернём в функцию
+    mockFetch(serperResponse([
+      { title: "A", link: "http://a", snippet: "sa", position: 1 },
+      { title: "B", link: "http://b", snippet: "sb" },
+    ]));
+    const r = await webSearch.searchWeb("q", { num: 5 });
+    assert.deepStrictEqual(r, [
+      { title: "A", link: "http://a", snippet: "sa", position: 1 },
+      { title: "B", link: "http://b", snippet: "sb", position: 2 },
+    ]);
+  });
+
+  // ── searchWeb: нет ключа -> понятная ошибка (отдельный класс) ───────────────
+  await check("searchWeb: нет SERPER_API_KEY -> MissingSerperKeyError", async () => {
+    delete process.env.SERPER_API_KEY;
+    await assert.rejects(() => webSearch.searchWeb("q"), (e) => e instanceof webSearch.MissingSerperKeyError);
+  });
+
+  // ── searchWeb: non-200 -> пустой результат ──────────────────────────────────
+  await check("searchWeb: non-200 -> []", async () => {
+    process.env.SERPER_API_KEY = "k";
+    mockFetch(serperResponse([], { ok: false, status: 429 }));
+    assert.deepStrictEqual(await webSearch.searchWeb("q"), []);
+  });
+
+  // ── searchWeb: таймаут/сеть (fetch бросает AbortError) -> [] ────────────────
+  await check("searchWeb: сбой fetch (таймаут) -> []", async () => {
+    process.env.SERPER_API_KEY = "k";
+    mockFetch(async () => {
+      const e = new Error("aborted");
+      e.name = "AbortError";
+      throw e;
+    });
+    assert.deepStrictEqual(await webSearch.searchWeb("q"), []);
+  });
+
+  // ── runChatWebSearch: rate-limit ДО Serper (fetch НЕ зовётся, usage НЕ пишется)
+  await check("runChatWebSearch: превышен лимит -> rate_limited, Serper НЕ вызван", async () => {
+    process.env.SERPER_API_KEY = "k";
+    process.env.WEB_SEARCH_RATE_PER_MIN = "3";
+    usageCount = 3; // уже 3 за минуту
+    let fetched = false;
+    mockFetch(async () => {
+      fetched = true;
+      return { ok: true, status: 200, async json() { return { organic: [] }; } };
+    });
+    usageCalls.length = 0;
+    const s = await webSearch.runChatWebSearch({ userId: "u", query: "q" });
+    assert.strictEqual(s.status, "rate_limited");
+    assert.strictEqual(s.limit, 3);
+    assert.strictEqual(fetched, false, "Serper НЕ должен вызываться при превышении");
+    assert.strictEqual(usageCalls.length, 0, "usage не пишется, если Serper не звали");
+  });
+
+  // ── runChatWebSearch: ok -> Serper вызван, usage записан (kind web_search, 0 токенов)
+  await check("runChatWebSearch: ok -> usage записан отдельной статьёй, токены 0/0", async () => {
+    process.env.SERPER_API_KEY = "k";
+    process.env.WEB_SEARCH_RATE_PER_MIN = "10";
+    usageCount = 0;
+    usageCalls.length = 0;
+    mockFetch(serperResponse([{ title: "A", link: "http://a", snippet: "sa", position: 1 }]));
+    const s = await webSearch.runChatWebSearch({ userId: "u", query: "q" });
+    assert.strictEqual(s.status, "ok");
+    assert.strictEqual(s.results.length, 1);
+    assert.strictEqual(usageCalls.length, 1);
+    assert.strictEqual(usageCalls[0].kind, "web_search");
+    assert.strictEqual(usageCalls[0].tokensIn, 0);
+    assert.strictEqual(usageCalls[0].tokensOut, 0);
+  });
+
+  // ── runChatWebSearch: нет ключа -> no_key, чат не падает ─────────────────────
+  await check("runChatWebSearch: нет ключа -> no_key (не бросает)", async () => {
+    delete process.env.SERPER_API_KEY;
+    usageCount = 0;
+    const s = await webSearch.runChatWebSearch({ userId: "u", query: "q" });
+    assert.strictEqual(s.status, "no_key");
+    assert.deepStrictEqual(s.results, []);
+  });
+
+  // ── эффективный тумблер: глобальный env + per-chat override ──────────────────
+  await check("webSearchEnabledFor: глобальный env + per-chat override", async () => {
+    process.env.WEB_SEARCH_ENABLED = "1";
+    assert.strictEqual(webSearch.webSearchEnabledFor(null), true, "глобально вкл");
+    assert.strictEqual(webSearch.webSearchEnabledFor({ webSearchEnabled: 0 }), false, "чат выкл переопределяет");
+    process.env.WEB_SEARCH_ENABLED = "0";
+    assert.strictEqual(webSearch.webSearchEnabledFor(null), false, "глобально выкл");
+    assert.strictEqual(webSearch.webSearchEnabledFor({ webSearchEnabled: 1 }), true, "чат вкл переопределяет");
+    assert.strictEqual(webSearch.webSearchEnabledFor({ webSearchEnabled: null }), false, "null наследует глобальный");
+  });
+
+  // ── глобус композера (OpenRouter ":online") рядом с Serper ───────────────────
+  await check("jaeWebSearchFlag: глобус как раньше, кроме случая с результатами Serper", async () => {
+    const f = webSearch.jaeWebSearchFlag;
+    const hit = { status: "ok", results: [{ title: "t", link: "l", snippet: "s", position: 1 }] };
+    assert.strictEqual(f(true, null), true, "Serper выключен -> глобус работает");
+    assert.strictEqual(f(false, null), false, "глобус не нажат -> выкл");
+    assert.strictEqual(f(true, hit), false, "Serper дал результаты -> без двойного поиска");
+    assert.strictEqual(f(false, hit), false);
+    assert.strictEqual(f(true, { status: "ok", results: [] }), true, "Serper пусто -> фолбэк на глобус");
+    for (const status of ["rate_limited", "no_key", "error"]) {
+      assert.strictEqual(f(true, { status, results: [] }), true, `${status} -> фолбэк на глобус`);
+    }
+  });
+
+  console.log(`\n${passed} проверок пройдено.`);
+}
+
+main().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});
